PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=desa_tenjonagara_db
DB_USER=postgres
DB_PASSWORD=postgres
# Set DB_SSL=false jika database lokal/VPS tanpa SSL
# Set DB_SSL=true jika menggunakan database cloud (Supabase, Neon, Render, dll)
DB_SSL=false
# Set DB_SSL_REJECT_UNAUTHORIZED=false jika cloud database menggunakan self-signed certificate
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication (JWT) - Gunakan string acak minimal 64 karakter di production
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_random_secret_panjang_dan_aman_minimal_64_karakter
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
# Development: http://localhost:5173
# Production: https://tenjonagara.id (atau domain/IP server)
CLIENT_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────────────────
# Cloudinary - Cloud Image/File Storage
# Daftarkan akun gratis di: https://cloudinary.com
# Wajib diisi di production agar file upload tidak hilang saat server restart.
# Jika tidak diisi (development), file akan disimpan di disk lokal (/public/uploads).
# ──────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
